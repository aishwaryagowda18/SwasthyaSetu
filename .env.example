# Copy this file to .env and fill in values locally.
# NEVER commit .env. NEVER put real values in this file.

# --- Supabase (added in Phase 4) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only master key. Keep it only in your local .env or hosting secrets.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI model (chat assistant) ---
# Put the real key in backend/.env (git-ignored). Optional: the chat answers from the database without it.
ANTHROPIC_API_KEY=

# --- Kannada voice / translation (added in Phase 8) ---
BHASHINI_API_KEY=

# --- App settings ---
APP_ENV=development
